# ── Copy this file to .env and fill in your values ──────────
# NEVER commit .env to git. It contains your secret API key.

# Your Anthropic API key (from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The Claude model to use (leave as-is unless told otherwise)
CLAUDE_MODEL=claude-sonnet-4-6

# Port the server runs on (Render sets this automatically)
PORT=3000
